<!DOCTYPE html>
<html lang="en">
<%- include("partials/header.ejs") %>

    <body>
        <%- include("partials/nav.ejs") %>
            <h1>Updating Author</h1>

            <div class="mainForm">
                <form method="POST" action="/updateAuthor">
                    <input type="hidden" name="authorId" value="<%= author[0].authorId%>">
                    First Name: <input type="text" name="firstName" value="<%= author[0].firstName%>"><br>
                    Last Name: <input type="text" name="lastName" value="<%= author[0].lastName%>"><br>
                    Profession: <input type="text" name="profession" value="<%= author[0].profession%>"><br>
                    Country: <input type="text" name="country" value="<%= author[0].country%>"><br>
                    Portrait: <input type="text" name="portrait" value="<%= author[0].portrait%>"><br>
                    Date of Birth: <input type="date" name="dob" value="<%= author[0].ISOdob%>"><br>
                    Sex: M<input type="radio" name="sex" value="M" <%=(author[0].sex=='M' )?"checked":""%>> F<input
                        type="radio" name="sex" value="F" <%=(author[0].sex=='F' )?"checked":""%>><br>
                    Biography: <textarea name="bio"><%= author[0].biography%></textarea><br>
                    <button> Update Author!</button>
                </form>
            </div>
    </body>
    <%- include("partials/footer.ejs") %>

</html>